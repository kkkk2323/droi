#!/usr/bin/env node
// Stand-in for the `droid` binary used by the Desktop Shell smoke suite. Only
// `daemon --port N` is understood: it answers GET /health and opens a WebSocket
// server on loopback that authenticates anyone and lists no Sessions, which is
// all the smoke cases need. The Gateway does the Pairing Token check and key
// injection in front of it.
import { createReadStream, writeFileSync } from 'node:fs'
import { createServer } from 'node:http'
import { WebSocketServer } from 'ws'

const args = process.argv.slice(2)
if (args[0] !== 'daemon') {
  console.error('fake-droid only supports: daemon --port <n>')
  process.exit(2)
}
const port = Number(args[args.indexOf('--port') + 1])
const server = createServer((request, response) => {
  if (request.url === '/health') {
    response.writeHead(200, { 'content-type': 'text/plain' })
    response.end('fake-droid ok')
    return
  }
  response.writeHead(404)
  response.end()
})
const wss = new WebSocketServer({ server })
server.listen(port, '127.0.0.1')

const envelope = { jsonrpc: '2.0', factoryApiVersion: '1.0.0', factoryProtocolVersion: '1.217.0' }

wss.on('connection', (ws) => {
  ws.on('message', (data) => {
    const message = JSON.parse(data.toString())
    const reply = (result) => ws.send(JSON.stringify({ ...envelope, type: 'response', id: message.id, result }))
    switch (message.method) {
      case 'daemon.authenticate':
        reply({ userId: 'user_smoke', orgId: 'org_smoke' })
        ws.send(
          JSON.stringify({
            ...envelope,
            type: 'notification',
            method: 'daemon.connection_status',
            params: { isDroidCLIInPath: true, droidCLIVersion: '0.0.0-smoke', homedir: '/tmp', platform: 'darwin' },
          }),
        )
        break
      case 'daemon.list_available_sessions':
        reply({ sessions: [], hasMore: false })
        break
      default:
        ws.send(
          JSON.stringify({
            ...envelope,
            type: 'response',
            id: message.id,
            error: { code: -32601, message: `fake-droid does not implement ${message.method}` },
          }),
        )
    }
  })
})

const parentPid = Number(args[args.indexOf('--parent-pid') + 1])
if (parentPid) {
  setInterval(() => {
    try {
      process.kill(parentPid, 0)
    } catch {
      process.exit(0)
    }
  }, 1000)
}
// Like the real Daemon: the inherited pipe closes when the Shell dies.
const livenessFd = Number(args[args.indexOf('--liveness-fd') + 1])
if (livenessFd) {
  createReadStream(null, { fd: livenessFd })
    .on('end', () => process.exit(0))
    .on('error', () => process.exit(0))
    .resume()
}
// Lets the smoke suite check what the Desktop Shell put in the Daemon's environment.
if (process.env.FAKE_DROID_ENV_FILE) {
  writeFileSync(
    process.env.FAKE_DROID_ENV_FILE,
    JSON.stringify({
      FACTORY_API_KEY: process.env.FACTORY_API_KEY ?? null,
      FACTORY_API_BASE_URL: process.env.FACTORY_API_BASE_URL ?? null,
    }),
  )
}
console.log(`fake-droid daemon listening on ${port}`)
