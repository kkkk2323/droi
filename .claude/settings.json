{
  "permissions": {
    "deny": [
      "Read(~/.config/dp/keys.txt)",
      "Read(~/Library/Application Support/mygo/update-keys/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(~/.droi/**)",
      "Edit(/apps/native/mygo.json)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --delete *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git tag -f *)",
      "Bash(git tag -d *)",
      "Bash(kubectl *)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(scripts/release.sh *)",
      "Bash(./scripts/release.sh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh", "timeout": 30 }]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scan-secrets.sh", "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/checks-before-done.sh", "timeout": 2400 }]
      }
    ]
  }
}
