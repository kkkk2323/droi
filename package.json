{
  "name": "droi-workspace",
  "private": true,
  "description": "Native Mac, Windows and iPhone app for Factory Droid: your droid Sessions in one window and on your phone, built with Go on MyGo",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "install:phone": "scripts/install-phone.sh",
    "lint": "oxlint apps",
    "lint:fix": "oxlint --fix apps",
    "format": "oxfmt --write apps",
    "format:check": "oxfmt --check apps",
    "check": "pnpm format:check && pnpm lint"
  },
  "author": "kkkk2323",
  "license": "MIT",
  "devDependencies": {
    "lucide-static": "1.47.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0"
  }
}
